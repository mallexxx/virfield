+    // SSH may disconnect during a successful shutdown. Only VM.run completion,
+    // which includes guestDidStop and session cleanup, confirms persistence.
+    static func waitForGuestShutdown(
+        request: () async throws -> Void,
+        completed: () -> Bool,
+        timeout: TimeInterval = 120,
+        pollNanoseconds: UInt64 = 1_000_000_000
+    ) async throws {
+        try? await request()
+        let deadline = Date().addingTimeInterval(timeout)
+        while !completed() {
+            guard Date() < deadline else {
+                throw UnattendedError.healthCheckFailed("Guest setup shutdown was not confirmed")
+            }
+            try await Task.sleep(nanoseconds: pollNanoseconds)
         }
