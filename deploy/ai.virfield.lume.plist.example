<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>/Users/VM_OWNER</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>ExitTimeOut</key>
	<integer>25</integer>
	<key>GroupName</key>
	<string>staff</string>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>ai.virfield.lume</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>/ABSOLUTE/DEPLOYMENT/bin/virfield-lume</string>
		<string>-config</string>
		<string>/ABSOLUTE/DEPLOYMENT/config.json</string>
		<string>-log</string>
		<string>/ABSOLUTE/DEPLOYMENT/lume.log</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/ABSOLUTE/DEPLOYMENT/lume.startup.log</string>
	<key>StandardOutPath</key>
	<string>/dev/null</string>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>Umask</key>
	<integer>63</integer>
	<key>UserName</key>
	<string>VM_OWNER</string>
	<key>WorkingDirectory</key>
	<string>/ABSOLUTE/DEPLOYMENT</string>
</dict>
</plist>
